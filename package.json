{
  "name": "medusa-mcp",
  "mcpName": "io.github.trhonpavel/medusa-mcp",
  "version": "0.4.0",
  "description": "MCP server for the Medusa v2 Admin API – orders, payments, returns, order edits, products, inventory, promotions, bulk changes, sales/customer/restock analytics with interactive MCP Apps dashboards. stdio or remote (Streamable HTTP + OAuth 2.1).",
  "keywords": [
    "analytics",
    "claude",
    "ecommerce",
    "mcp",
    "mcp-apps",
    "medusa",
    "medusajs",
    "model-context-protocol",
    "oauth"
  ],
  "author": "Pavel Trhoň",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trhonpavel/medusa-mcp.git"
  },
  "homepage": "https://github.com/trhonpavel/medusa-mcp#readme",
  "bugs": {
    "url": "https://github.com/trhonpavel/medusa-mcp/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "medusa-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.cs.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && node scripts/build-ui.mjs",
    "build:mcpb": "npm run build && node scripts/build-mcpb.mjs",
    "start": "node dist/index.js http",
    "start:stdio": "node dist/index.js stdio",
    "dev": "tsx src/index.ts http",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test 'test/*.test.mjs'",
    "smoke": "node scripts/smoke.mjs",
    "prepublishOnly": "npm run build",
    "version": "node scripts/sync-version.mjs && git add .claude-plugin/plugin.json server.json src/server.ts"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
