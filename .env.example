# --- Medusa ---
MEDUSA_BACKEND_URL=https://api.example.com
# Secret API key from Medusa Admin (Settings → Developer → Secret API Keys), starts with sk_
MEDUSA_API_KEY=sk_xxxxxxxxxxxxxxxx
# true = register read and report tools only
MEDUSA_READ_ONLY=false
# IANA timezone for date filters and report buckets, e.g. Europe/Prague
REPORT_TIMEZONE=UTC
# Optional: only these tool groups (orders,customers,products,catalog,inventory,pricing,promotions,reports,bulk,raw)
MEDUSA_TOOLSETS=
# false = no generic medusa_request tool
MEDUSA_RAW_API=true
# Optional: file that receives every write tool call as a JSON line (they always go to stderr / docker logs)
AUDIT_LOG=

# --- HTTP / remote connector ---
# Public HTTPS origin of this server (without /mcp)
PUBLIC_URL=https://mcp.example.com
# Password you enter on the consent page when connecting a client (long and random)
OWNER_PASSWORD=
# Optional static bearer token for Claude Code / scripts (openssl rand -base64 32)
MCP_STATIC_TOKEN=
# Hosts OAuth clients may redirect to after consent
ALLOWED_REDIRECT_HOSTS=claude.ai,claude.com,chatgpt.com,localhost,127.0.0.1
# Number of reverse proxies in front of the server (for per-IP rate limiting)
TRUST_PROXY=1
PORT=3000
ACCESS_TOKEN_TTL=3600
REFRESH_TOKEN_TTL=2592000
